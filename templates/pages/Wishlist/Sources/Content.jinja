{#def
    result: QueryResult,
#}

{% set book_id = result.book.id if result.book.id is defined else result.book.asin %}
{% set is_manual = result.book.id is defined %}

<div class="w-full p-3 md:p-4 lg:p-8 flex flex-col gap-3" id="sources">
    <a preload
       href="{{ base_url }}/wishlist{% if is_manual %}/manual{% endif %}#{{ book_id }}"
       class="w-fit btn btn-ghost">&lt; Back to wishlist</a>
    <h1 class="text-2xl sm:text-3xl font-bold break-words">
        Sources for {{ result.book.title }}
    </h1>
    {% if result.ok and not result.sources %}
        <div role="alert" class="alert">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>No results found for "{{ result.book.title }}" by
                {{ result.book.authors|join(",") }}. Might have to be looked up
            manually.</span>
        </div>
    {% elif not result.ok %}
        <div role="alert"
             class="alert"
             hx-get="{{ base_url }}/wishlist/sources/{{ book_id }}?only_body=true"
             hx-trigger="load"
             hx-target="#sources"
             hx-swap="outerHTML">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>Fetching sources from prowlarr
                <span class="ml-2 loading loading-dots"></span>
            </span>
        </div>
    {% endif %}
    <div class="lg:overflow-x-auto">
        <table class="wishlist-table is-sources table table-zebra table-pin-rows min-w-240">
            <thead>
                <tr>
                    <th>
                    </th>
                    <th>
                        title
                    </th>
                    <th>
                        author(s)
                    </th>
                    <th>
                        narrator(s)
                    </th>
                    <th>
                        indexer
                    </th>
                    <th>
                        flags
                    </th>
                    <th>
                        seed / leech (or grabs)
                    </th>
                    <th>
                        size (MB)
                    </th>
                    <th>
                        publish date
                    </th>
                    <th>
                    </th>
                </tr>
            </thead>
            <tbody>
                {% for source in (result.sources or []) %}
                    <tr class="text-xs lg:text-sm {% if loop.index==1 %}bg-success dark:text-gray-700{% endif %}">
                        <th class="w-index">
                            {{ loop.index }}
                        </th>
                        <td class="w-title">
                            {% if source.info_url %}
                                <a href="{{ source.info_url }}" class="link">{{ source.title }}</a>
                            {% else %}
                                {{ source.title }}
                            {% endif %}
                        </td>
                        <td class="w-authors">
                            {% if source.book_metadata.authors %}
                                {{ source.book_metadata.authors|join(", ") }}
                            {% endif %}
                        </td>
                        <td class="w-narrators">
                            {% if source.book_metadata.narrators %}
                                {{ source.book_metadata.narrators|join(", ") }}
                            {% endif %}
                        </td>
                        <td class="w-indexer">
                            {{ source.indexer }}
                        </td>
                        <td class="w-flags">
                            {{ source.indexer_flags|join(", ") }}
                        </td>
                        {% if source.protocol == "torrent" %}
                            <td class="w-stats">
                                <span class="lg:hidden opacity-70">seeds/leech </span>{{ source.seeders }} / {{ source.leechers }}
                            </td>
                        {% else %}
                            <td class="w-stats">
                                <span class="lg:hidden opacity-70">grabs </span>{{ source.grabs }}
                            </td>
                        {% endif %}
                        <td class="w-size">
                            <span class="lg:hidden opacity-70">size </span>{{ source.size_MB }} MB
                        </td>
                        <td class="w-date">
                            {{ source.publish_date.strftime("%d. %b %Y") }}
                        </td>
                        <td class="w-control">
                            <label id="form-{{ loop.index }}"
                                   class="swap swap-flip"
                                   title="Send to download client">
                                <input id="checkbox-{{ loop.index }}"
                                       type="checkbox"
                                       hx-trigger="click"
                                       hx-target="this"
                                       hx-post="{{ base_url }}/wishlist/sources/{{ book_id }}"
                                       hx-include="#form-{{ loop.index }}"
                                       hx-on::after-request="if (event.detail.successful) this.disabled = true" />
                                <input type="hidden" name="indexer_id" value="{{ source.indexer_id }}" />
                                <input type="hidden" name="guid" value="{{ source.guid }}" />
                                <span class="swap-off">
                                    <icons.Download />
                                </span>
                                <span class="swap-on text-success">
                                    <icons.Checkmark />
                                </span>
                            </label>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
