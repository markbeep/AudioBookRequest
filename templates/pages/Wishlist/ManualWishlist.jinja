{#def
    results: list[ManualBookRequest],
    user: DetailedUser,
    counts: WishlistCounts,
    show_sources: bool,
    update_tablist = False, # performs oob replacement for the tablist
#}

<table id="book-table-body"
       class="wishlist-table is-manual table table-pin-rows min-w-240">
    {% if update_tablist %}
        <Wishlist.Tablist page="manual" counts={{ counts }} />
    {% endif %}

    <thead>
        <tr>
            <th>
            </th>
            <th>
                Title
            </th>
            <th>
                Author
            </th>
            <th>
                Narrator
            </th>
            <th>
                Released
            </th>
            <th>
                Info
            </th>
            <th>
                Requested by
            </th>
            <th>
            </th>
        </tr>
    </thead>
    {% if not results %}
        <div role="alert" class="alert my-2">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>
                No manual book requests on your wishlist. Add some books by heading to
                the
                <a preload class="link" href="{{ base_url }}/search/manual">search</a>
                tab.
            </span>
        </div>
    {% endif %}
    <tbody>
        {% for book in results %}
            <tr id="{{ book.id }}"
                class="text-xs lg:text-sm {% if book.fulfilled %}bg-success/30{% endif %}">
                <th class="w-index">
                    {{ loop.index }}
                </th>
                <td class="w-title {% if book.subtitle %}flex{% endif %} flex-col">
                    <span>{{ book.title }}</span>
                    {% if book.subtitle %}
                        <span class="font-semibold line-clamp-4">{{ book.subtitle }}</span>
                    {% endif %}
                    {% if book.admin_note %}
                        <div class="mt-1 text-xs font-normal text-warning whitespace-pre-line">
                            Note: {{ book.admin_note }}
                        </div>
                    {% endif %}
                </td>
                <td class="w-author">
                    {% if book.authors %}
                        <span class="lg:hidden opacity-70">by </span>{{ book.authors|join(", ") }}
                    {% endif %}
                </td>
                <td class="w-narrator">
                    {% if book.narrators %}
                        <span class="lg:hidden opacity-70">narrated by </span>{{ book.narrators|join(", ") }}
                    {% endif %}
                </td>
                <td class="w-date">
                    {% if book.publish_date %}
                        <span class="lg:hidden opacity-70">released </span>{{ book.publish_date }}
                    {% endif %}
                </td>
                <td class="w-info">
                    {% if book.additional_info %}
                        <span class="lg:hidden opacity-70">info: </span>{{ book.additional_info }}
                    {% endif %}
                </td>
                <td class="w-requester">
                    <span class="lg:hidden opacity-70">requested by </span>{{ book.user_username }}
                </td>
                <td class="w-actions grid grid-cols-2 min-w-32 gap-1 w-fit ml-auto">
                    {% if show_sources %}
                        <a preload
                           title="Torrent Sources"
                           href="{{ base_url }}/wishlist/sources/{{ book.id }}"
                           {% if not user.is_admin() %}disabled{% endif %}
                           class="btn btn-square">
                            <icons.List />
                        </a>
                    {% endif %}
                    <a class="btn btn-square"
                       href="{{ base_url }}/search/manual?id={{ book.id }}"
                       title="Edit">
                        <icons.Pencil />
                    </a>
                    <button title="Remove"
                            class="btn btn-square"
                            {% if not user.is_admin() %}disabled{% endif %}
                            hx-delete="{{ base_url }}/wishlist/manual/hx-delete/{{ book.id }}"
                            hx-swap="outerHTML"
                            hx-target="#book-table-body"
                            hx-disabled-elt="this">
                        <icons.Ban />
                    </button>
                    {% if book.fulfilled %}
                        <button class="btn btn-square btn-ghost bg-success text-neutral/20"
                                disabled
                                title="Set as fulfilled">
                            <icons.Checkmark />
                        </button>
                    {% else %}
                        <button class="btn btn-square"
                                title="Set as fulfilled"
                                {% if not user.is_admin() %}disabled{% endif %}
                                hx-patch="{{ base_url }}/wishlist/manual/hx-add/{{ book.id }}"
                                hx-swap="outerHTML"
                                hx-target="#book-table-body"
                                hx-disabled-elt="this">
                            <icons.Checkmark />
                        </button>
                    {% endif %}
                    {% if user.is_admin() %}
                        <button title="{% if book.admin_note %}Edit note{% else %}Add note{% endif %}"
                                class="btn btn-square"
                                onclick="noteModal{{ book.id }}.showModal()">
                            <icons.Pencil />
                        </button>
                        <dialog id="noteModal{{ book.id }}"
                                class="modal"
                                aria-labelledby="note-title-{{ book.id }}">
                            <div class="modal-box max-w-2xl">
                                <h3 id="note-title-{{ book.id }}" class="text-lg font-bold break-words">
                                    Admin note for <span class="italic">{{ book.title }}</span>
                                </h3>
                                <form class="mt-4"
                                      hx-put="{{ base_url }}/wishlist/manual/hx-note/{{ book.id }}"
                                      hx-target="#book-table-body"
                                      hx-swap="outerHTML"
                                      hx-disabled-elt="find button[type='submit']">
                                    <label for="note-{{ book.id }}" class="flex flex-col gap-2">
                                        <span class="text-sm font-semibold">Note</span>
                                        <textarea id="note-{{ book.id }}"
                                                  name="note"
                                                  class="textarea w-full h-32 resize-y leading-relaxed"
                                                  maxlength="2000"
                                                  placeholder="Why can't this request be fulfilled right now?">{{ book.admin_note or "" }}</textarea>
                                    </label>
                                    <div class="modal-action">
                                        <button type="button" class="btn" onclick="this.closest('dialog').close()">
                                            Cancel
                                        </button>
                                        <button type="submit" class="btn btn-primary">
                                            Save note
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <form method="dialog" class="modal-backdrop">
                                <button>close</button>
                            </form>
                        </dialog>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
