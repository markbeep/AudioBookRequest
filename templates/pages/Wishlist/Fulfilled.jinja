{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    counts: WishlistCounts,
    show_sources: bool,
#}

<WishlistLayout title="Fulfilled" user={{ user }} counts={{ counts }} page="fulfilled">
<div class="overflow-x-auto h-[75vh] border-b pb-2 border-b-base-200">
    <Wishlist.Wishlist results={{ results }} user={{ user }} page="fulfilled" counts={{ counts }} show_sources={{ show_sources }} />
</div>
</WishlistLayout>
