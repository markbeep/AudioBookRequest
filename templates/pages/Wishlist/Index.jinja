{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    counts: WishlistCounts,
    show_sources: bool,
#}

<WishlistLayout title="Wishlist" user={{ user }} counts={{ counts }} page="wishlist">
<div class="lg:overflow-x-auto lg:h-[75vh] border-b pb-2 border-b-base-200">
    <Wishlist.Wishlist results={{ results }} user={{ user }} page="wishlist" counts={{ counts }} show_sources={{ show_sources }} />
</div>
</WishlistLayout>
