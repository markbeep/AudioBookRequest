{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    page: str,
    counts: WishlistCounts,
    show_sources: bool,
    update_tablist = False, # performs oob replacement for the tablist
#}

<table id="book-table-body"
       class="wishlist-table has-cover table table-pin-rows min-w-240">
    {% if update_tablist %}
        <Wishlist.Tablist page={{ page }} counts={{ counts }} />
    {% endif %}

    <thead>
        <tr>
            <th>
            </th>
            <th>
            </th>
            <th>
                Title
            </th>
            <th>
                Author
            </th>
            <th>
                Narrator
            </th>
            <th>
                Release
            </th>
            <th>
                Length (hrs)
            </th>
            <th>
                # Requested
            </th>
            <th>
            </th>
        </tr>
    </thead>
    {% if not results %}
        <div role="alert" class="alert my-2">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>
                {% if page.__eq__("wishlist") %}
                    No books on your wishlist. Add some
                    books by heading to the
                    <a preload class="link" href="{{ base_url }}/search">search</a> tab {%
                    elif page.__eq__("fulfilled") %} No requests have been fulfilled yet. {%
                        endif %}
                    </span>
                    </div>
                {% endif %}
                <tbody>
                    {% for result in results %}
                        {% set book = result.book %}
                        <tr class="text-xs lg:text-sm" id="{{ book.asin }}">
                            <th class="w-index">
                                {{ loop.index }}
                            </th>
                            <td class="w-cover">
                                <div class="size-16 lg:size-24">
                                    {% if book.cover_image %}
                                        <img class="object-cover w-full h-full cursor-pointer"
                                             height="64"
                                             width="64"
                                             src="{{ book.cover_image }}"
                                             alt="{{ book.title }}"
                                             title="Click to enlarge"
                                             onclick="bookCoverModal{{ book.asin }}.showModal()" />
                                        <dialog id="bookCoverModal{{ book.asin }}" class="modal book-cover-modal">
                                            <div class="modal-box">
                                                <img src="{{ book.cover_image }}" alt="{{ book.title }}" />
                                            </div>
                                            <form method="dialog" class="modal-backdrop">
                                                <button aria-label="Close">close</button>
                                            </form>
                                        </dialog>
                                    {% else %}
                                        <div class="flex items-center justify-center w-full h-full bg-neutral opacity-30">
                                            <icons.PhotoOff />
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="w-title">
                                <div class="flex flex-col">
                                    <a preload
                                       href="{{ base_url }}/search?q={{ book.title+' ' +(book.authors|join(",") ) }}"
                                       class="font-bold text-primary line-clamp-4"
                                       title="{{ book.title }}">{{ book.title }}</a>
                                    {% if book.subtitle %}
                                        <span class="font-semibold line-clamp-4" title="{{ book.subtitle }}">{{ book.subtitle }}</span>
                                    {% endif %}
                                    {% if book.admin_note %}
                                        <div class="mt-1 text-xs font-normal text-warning whitespace-pre-line">
                                            Note: {{ book.admin_note }}
                                        </div>
                                    {% endif %}
                                </div>
                            </td>
                            <td class="w-author">
                                {% if book.authors %}
                                    <span class="lg:hidden opacity-70">by </span>{{ book.authors|join(", ") }}
                                {% endif %}
                            </td>
                            <td class="w-narrator">
                                {% if book.narrators %}
                                    <span class="lg:hidden opacity-70">narrated by </span>{{ book.narrators|join(", ") }}
                                {% endif %}
                            </td>
                            <td class="hidden lg:table-cell">
                                {{ book.release_date.strftime("%B %Y") }}
                            </td>
                            <td class="lg:hidden w-year">
                                {{ book.release_date.strftime("%Y") }}
                            </td>
                            <td class="w-length">
                                {{ book.runtime_length_hrs }}<span class="lg:hidden opacity-70"> hrs</span>
                            </td>

                            <td class="w-requested" title="{{ result.amount_requested }}">
                                {% if user.is_admin() %}
                                    <button class="btn px-1 text-sm"
                                            title="View requesters"
                                            onclick="requesters{{ loop.index }}.showModal()">
                                        {{ result.amount_requested }}
                                        <icons.Users />
                                    </button>
                                    <dialog id="requesters{{ loop.index }}" class="modal">
                                        <div class="modal-box">
                                            <h3 class="text-lg font-bold">
                                                Users that requested:
                                                <span class="italic">{{ book.title }}</span>
                                            </h3>
                                            <ul class="py-4 text-sm max-h-60 overflow-y-auto truncate list-disc list-inside">
                                                {% for user in result.requests %}
                                                    <li>
                                                        {{ user.user_username }}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                        <form method="dialog" class="modal-backdrop">
                                            <button>
                                                close
                                            </button>
                                        </form>
                                    </dialog>
                                {% else %}
                                    {{ result.amount_requested }}<span class="lg:hidden" title="Requested"><icons.Users /></span>
                                {% endif %}
                            </td>

                            <td class="w-actions grid grid-cols-2 min-w-32 gap-1 w-fit ml-auto">
                                {% if show_sources %}
                                    <a preload
                                       title="Torrent Sources"
                                       href="{{ base_url }}/wishlist/sources/{{ book.asin }}"
                                       {% if not user.is_admin() %}disabled{% endif %}
                                       class="btn btn-square">
                                        <icons.List />
                                    </a>
                                {% endif %}
                                <button {% if book.fulfilled %}title="Fulfilled"class="btn btn-square btn-ghost bg-success text-neutral/20" {% else %} title="Automatic Download" class="btn btn-square" {% endif %}
                                        {% if not user.can_download() or book.fulfilled %}disabled{% endif %}
                                        hx-post="{{ base_url }}/wishlist/hx-auto-download/{{ book.asin }}"
                                        hx-swap="outerHTML"
                                        hx-target="#book-table-body"
                                        hx-disabled-elt="this">
                                    <icons.Download />
                                </button>
                                <button title="Remove"
                                        class="btn btn-square"
                                        hx-delete="{{ base_url }}/wishlist/hx-delete/{{ book.asin }}{%- if page.__eq__('fulfilled') -%}?fulfilled=true{%- endif -%}"
                                        hx-swap="outerHTML"
                                        hx-target="#book-table-body"
                                        hx-disabled-elt="this">
                                    <icons.Ban />
                                </button>
                                {% if book.fulfilled %}
                                    <button class="btn btn-square btn-ghost bg-success text-neutral/20"
                                            disabled
                                            title="Set as fulfilled">
                                        <icons.Checkmark />
                                    </button>
                                {% else %}
                                    <button class="btn btn-square"
                                            title="Set as fulfilled"
                                            hx-patch="{{ base_url }}/wishlist/fulfilled/hx-add/{{ book.asin }}"
                                            {% if not user.is_admin() %}disabled{% endif %}
                                            hx-swap="outerHTML"
                                            hx-target="#book-table-body"
                                            hx-disabled-elt="this">
                                        <icons.Checkmark />
                                    </button>
                                {% endif %}
                                {% if user.is_admin() and page.__eq__("wishlist") %}
                                    <button title="{% if book.admin_note %}Edit note{% else %}Add note{% endif %}"
                                            class="btn btn-square"
                                            onclick="noteModal{{ book.asin }}.showModal()">
                                        <icons.Pencil />
                                    </button>
                                    <dialog id="noteModal{{ book.asin }}"
                                            class="modal"
                                            aria-labelledby="note-title-{{ book.asin }}">
                                        <div class="modal-box max-w-2xl">
                                            <h3 id="note-title-{{ book.asin }}" class="text-lg font-bold break-words">
                                                Admin note for <span class="italic">{{ book.title }}</span>
                                            </h3>
                                            <form class="mt-4"
                                                  hx-put="{{ base_url }}/wishlist/hx-note/{{ book.asin }}"
                                                  hx-target="#book-table-body"
                                                  hx-swap="outerHTML"
                                                  hx-disabled-elt="find button[type='submit']">
                                                <label for="note-{{ book.asin }}" class="flex flex-col gap-2">
                                                    <span class="text-sm font-semibold">Note</span>
                                                    <textarea id="note-{{ book.asin }}"
                                                              name="note"
                                                              class="textarea w-full h-32 resize-y leading-relaxed"
                                                              maxlength="2000"
                                                              placeholder="Why can't this request be fulfilled right now?">{{ book.admin_note or "" }}</textarea>
                                                </label>
                                                <div class="modal-action">
                                                    <button type="button" class="btn" onclick="this.closest('dialog').close()">
                                                        Cancel
                                                    </button>
                                                    <button type="submit" class="btn btn-primary">
                                                        Save note
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                        <form method="dialog" class="modal-backdrop">
                                            <button>close</button>
                                        </form>
                                    </dialog>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
